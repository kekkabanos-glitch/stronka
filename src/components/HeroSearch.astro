                </div>
            </div>

            <!-- RIGHT: Dual preview (Math + Code) -->
            <div
                class="lg:col-span-2 w-full max-w-2xl mx-auto mt-4 lg:mt-0 lg:max-w-none"
            >
                <div
                    class="grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-1"
                >
                    <!-- TOP CARD — Matematyka CKE -->
                    <div
                        class="rounded-md border border-slate-200 bg-white shadow-md shadow-slate-900/5"
                    >
                        <div
                            class="flex items-center justify-between border-b border-slate-200 px-3 py-2 sm:px-4 sm:py-2.5"
                        >
                            <div class="flex items-center gap-2 min-w-0">
                                <span
                                    class="flex h-4 w-4 sm:h-5 sm:w-5 shrink-0 items-center justify-center rounded bg-blue-600 font-mono text-[9px] sm:text-[10px] font-bold text-white"
                                    >∑</span
                                >
                                <span
                                    class="font-mono text-[11px] sm:text-xs font-semibold tracking-wide text-slate-900 truncate"
                                    >MATEMATYKA CKE</span
                                >
                            </div>
                            <span
                                class="font-mono text-[9px] sm:text-[10px] text-slate-400 truncate ml-1"
