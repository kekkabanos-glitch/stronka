                            >
                        </div>

                        <div
                            class="bg-white p-3 font-mono text-[10px] leading-relaxed sm:p-4 sm:text-xs lg:text-[12px] xl:text-[13px]"
                        >
                            <div class="space-y-1 text-slate-700">
                                <div
                                    class="text-slate-400 text-[9px] sm:text-[11px]"
                                >
                                    # Zadanie CKE — Rozwiąż równanie
                                </div>
                                <div class="text-slate-900 font-medium">
                                    f(x) = <span class="text-blue-600">2</span
                                    >x² − <span class="text-blue-600">8</span>x
                                    + <span class="text-blue-600">6</span>
                                </div>
                                <div class="text-slate-200">
                                    ────────────────────────────
                                </div>
                                <div>
                                    Δ = b² − 4ac = 64 − 48 = <span
                                        class="text-emerald-600 font-semibold"
                                        >16</span
                                    >
                                </div>
                                <div>
                                    √Δ = <span
                                        class="text-emerald-600 font-semibold"
                                        >4</span
                                    >
                                </div>
                                <div>
                                    x₁ = 1, x₂ = 3 | <span
                                        class="text-slate-900 font-semibold"
                                        >W = (2, −2)</span
                                    >
                                </div>
                                <div class="text-emerald-600 pt-0.5">
                                    ✓ Odp: x₁ = 1, x₂ = 3
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BOTTOM CARD — Programowanie INF.03/04 -->
                    <div
                        class="overflow-hidden rounded-md border border-slate-800 bg-slate-900 shadow-md shadow-slate-900/5"
                    >
                        <div
                            class="flex items-center justify-between border-b border-slate-800 px-3 py-2 sm:px-4 sm:py-2.5"
                        >
                            <div class="flex items-center gap-2 min-w-0">
                                <span
                                    class="h-2 w-2 sm:h-2.5 sm:w-2.5 rounded-full bg-emerald-500/80 shrink-0"
                                ></span>
                                <span
                                    class="font-mono text-[11px] sm:text-xs font-semibold tracking-wide text-emerald-400 truncate"
                                    >PROGRAMOWANIE INF.03/04</span
                                >
                            </div>
                            <span
                                class="font-mono text-[9px] sm:text-[10px] text-slate-500 ml-1"
                                >Python 3.12</span
                            >
                        </div>

                        <div
                            class="bg-grid-dark p-3 font-mono text-[10px] leading-relaxed sm:p-4 sm:text-xs lg:text-[12px] xl:text-[13px]"
                        >
                            <div
                                class="space-y-0.5 sm:space-y-1 text-slate-300"
                            >
                                <div>
                                    <span class="text-emerald-500">$</span>
                                    <span class="text-slate-100"
                                        >logarytmika solve</span
                                    >
                                    <span class="text-blue-400">"INF.04"</span>
                                </div>
                                <div class="text-slate-700">
                                    ────────────────────────────
                                </div>
                                <div>
                                    <span class="text-blue-400">def</span>
                                    <span class="text-slate-100"
                                        >bubble_sort(arr):</span
                                    >
                                </div>
                                <div class="pl-2">
                                    <span class="text-slate-400"
                                        >n =
                                    </span><span class="text-amber-400"
                                        >len</span
                                    ><span class="text-slate-400">(arr)</span>
                                </div>
                                <div class="pl-2">
                                    <span class="text-blue-400">for</span>
                                    <span class="text-slate-200">i</span>
                                    <span class="text-blue-400">in</span>
                                    <span class="text-amber-400">range</span
                                    ><span class="text-slate-300">(n):</span>
                                </div>
                                <div class="pl-4">
                                    <span class="text-blue-400">if</span>
                                    <span class="text-slate-300"
                                        >arr[j] &gt; arr[j+1]:</span
                                    >
                                </div>
                                <div class="pl-6 text-slate-400">
                                    arr[j], arr[j+1] = arr[j+1], arr[j]
                                </div>
                                <div class="pt-0.5">
                                    <span class="text-emerald-500">✓</span>
                                    <span class="text-slate-100"
                                        >Złożoność O(n²)</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Value props below dual preview -->
                <div
                    class="mt-3 grid grid-cols-3 gap-px border border-slate-200 bg-slate-200"
                >
                    <div class="bg-white px-2.5 py-1.5 sm:px-3 sm:py-2">
                        <div
                            class="font-mono text-xs sm:text-sm font-bold text-slate-900"
                        >
                            80 zł
                        </div>
                        <div class="text-[10px] text-slate-500">
                            Za 60 min 1:1
                        </div>
                    </div>
                    <div class="bg-white px-2.5 py-1.5 sm:px-3 sm:py-2">
                        <div
                            class="font-mono text-xs sm:text-sm font-bold text-slate-900"
                        >
                            1:1
                        </div>
                        <div class="text-[10px] text-slate-500">
                            Wirtualna sala
                        </div>
                    </div>
                    <div class="bg-white px-2.5 py-1.5 sm:px-3 sm:py-2">
                        <div
                            class="font-mono text-xs sm:text-sm font-bold text-slate-900"
                        >
                            PDF
                        </div>
                        <div class="text-[10px] text-slate-500">
                            Notatki &amp; kod
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style is:global>
    .cursor {
        animation: blink 1s step-end infinite;
    }
    @keyframes blink {
        50% {
            opacity: 0;
        }
    }
</style>

<script>
    const form = document.getElementById(
        "hero-search-form",
    ) as HTMLFormElement | null;
    const input = document.getElementById(
        "hero-search-input",
    ) as HTMLInputElement | null;

    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const query = input?.value.trim();
        if (query) {
            const tasksSection = document.getElementById("arkusze");
            tasksSection?.scrollIntoView({ behavior: "smooth" });
        }
    });

    document.querySelectorAll(".quick-search").forEach((btn) => {
        btn.addEventListener("click", () => {
            const query = (btn as HTMLElement).dataset.query || "";
            if (input) {
                input.value = query;
                input.focus();
            }
        });
    });
</script>
