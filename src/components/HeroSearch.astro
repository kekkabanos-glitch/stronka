---
// HeroSearch.astro — Asymmetric 60/40 with dual Math + Code preview
---

<section
    class="relative border-b border-slate-200 bg-white overflow-hidden min-h-[calc(100vh-3.5rem)] flex items-center"
>
    <!-- Subtle grid overlay only -->
    <div class="pointer-events-none absolute inset-0 bg-grid opacity-40"></div>

    <div
        class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-16 w-full"
    >
        <!-- Top breadcrumb / status line -->
        <div
            class="mb-4 flex items-center gap-3 font-mono text-xs text-slate-500"
        >
            <span class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
                ONLINE
            </span>
            <span class="text-slate-300">/</span>
            <span>Baza zadań CKE</span>
            <span class="text-slate-300">/</span>
            <span class="text-slate-900">2025–2026</span>
        </div>

        <!-- Asymmetric grid: 60% left, 40% right -->
        <div
            class="grid grid-cols-1 gap-6 lg:grid-cols-5 lg:gap-8 xl:gap-10 items-center"
        >
            <!-- LEFT: Title + Search -->
            <div class="lg:col-span-3">
                <p class="section-label mb-3 sm:mb-4">
                    Egzamin 8-klasisty · Matura · INF.03 · INF.04
                </p>

                <h1
                    class="text-[2.25rem] font-bold leading-[1.1] tracking-tight text-slate-900 sm:text-5xl lg:text-[3.25rem]"
                >
                    Egzamin 8-klasisty, Matura<br />
                    i <span class="text-blue-600">INF.03/INF.04</span><br />
                    <span class="font-serif italic font-normal text-slate-600"
                        >rozbite na czynniki pierwsze.</span
                    >
                </h1>

                <p
                    class="mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-slate-600"
                >
                    Matematyka dla Egzaminu Ósmoklasisty oraz Matematyka (PP/PR)
                    i Informatyka dla Matury. Przygotowanie do egzaminów
                    zawodowych INF.03 i INF.04.
                </p>

                <!-- Exam scope badges -->
                <div class="mt-4 sm:mt-5 flex flex-wrap gap-1.5 sm:gap-2">
                    <span
                        class="border border-slate-300 bg-slate-50 px-2.5 py-1 font-mono text-[11px] sm:text-xs font-medium text-slate-700"
                    >
                        Egzamin 8-klasisty: Matematyka
                    </span>
                    <span
                        class="border border-slate-300 bg-slate-50 px-2.5 py-1 font-mono text-[11px] sm:text-xs font-medium text-slate-700"
                    >
                        Matura: Matematyka PP/PR + Informatyka
                    </span>
                    <span
                        class="border border-blue-300 bg-blue-50 px-2.5 py-1 font-mono text-[11px] sm:text-xs font-medium text-blue-700"
                    >
                        INF.03 / INF.04: Programowanie
                    </span>
                </div>

                <!-- Dark search bar -->
                <div class="mt-6 sm:mt-8 max-w-xl">
