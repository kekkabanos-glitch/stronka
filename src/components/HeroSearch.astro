                    </form> -->

                    <!-- Quick suggestions -->
                    <!-- <div
                        class="mt-2.5 sm:mt-3 flex flex-wrap items-center gap-1.5 sm:gap-2"
                    >
                        <span
                            class="font-mono text-[11px] sm:text-xs text-slate-400"
