---
const phoneNumber = "+48575827306";
const formattedPhone = "575 827 306";
const defaultSmsBody = encodeURIComponent(
    "Cześć! Chcę zarezerwować lekcję z Matematyki / INF.03 / INF.04. Myślę o terminie: ",
);

const footerLinks = [
    /*{
        title: "Egzaminy",
        links: [
            { label: "Egzamin 8-klasisty", href: "#arkusze" },
            { label: "Matura — Podstawowy", href: "#arkusze" },
            { label: "Matura — Rozszerzony", href: "#arkusze" },
            { label: "INF.03", href: "#arkusze" },
            { label: "INF.04", href: "#arkusze" },
        ],
    },*/
    {
        title: "Platforma",
        links: [
            { label: "Korepetycje", href: "#korepetycje" },
            //{ label: "Arkusze CKE", href: "#arkusze" },
            //{ label: "Baza Wiedzy", href: "#baza-wiedzy" },
            { label: "Cennik", href: "#cennik" },
            { label: "Panel Ucznia", href: "https://app.logarytmika.pl" },
        ],
    },
    {
        title: "Kontakt",
        links: [
            {
                label: "kontakt@logarytmika.pl",
                href: "mailto:kontakt@logarytmika.pl",
            },
            //{ label: "Polityka prywatności", href: "#" },
            //{ label: "Regulamin", href: "#" },
        ],
    },
];
---

<!-- CTA Section -->
<section id="cennik" class="border-b border-slate-200 bg-white">
    <div class="container-prose relative py-16 lg:py-24">
        <div class="overflow-hidden border-2 border-slate-900 bg-slate-50">
            <div class="grid grid-cols-1 lg:grid-cols-2">
                <!-- Left: pitch -->
                <div class="p-8 lg:p-12 flex flex-col justify-between">
                    <div>
                        <p class="section-label mb-4">
                            Cennik · Korepetycje 1:1
                        </p>
                        <h2
                            class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
                        >
                            Zarezerwuj swoją lekcję.
                        </h2>
                        <p
                            class="mt-4 text-base leading-relaxed text-slate-600"
                        >
                            Indywidualne korepetycje 1:1 online. Pierwsza lekcja
                            diagnostyczna gratis. Wybierz termin, który Ci
                            pasuje — uczymy się w Twoim tempie.
                        </p>

                        <ul class="mt-6 space-y-2.5">
                            <li
                                class="flex items-start gap-3 text-sm text-slate-700"
                            >
                                <svg
                                    class="mt-0.5 h-5 w-5 flex-none text-emerald-600"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="m4.5 12.75 6 6 9-13.5"></path>
                                </svg>
                                Pierwsza lekcja diagnostyczna gratis
                            </li>
                            <li
                                class="flex items-start gap-3 text-sm text-slate-700"
                            >
                                <svg
                                    class="mt-0.5 h-5 w-5 flex-none text-emerald-600"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="m4.5 12.75 6 6 9-13.5"></path>
                                </svg>
                                Notatki z tablicy i komplet kodu w PDF po zajęciach
                            </li>
                            <li
                                class="flex items-start gap-3 text-sm text-slate-700"
                            >
                                <svg
                                    class="mt-0.5 h-5 w-5 flex-none text-emerald-600"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="m4.5 12.75 6 6 9-13.5"></path>
                                </svg>
                                Wirtualna tablica i edytor kodu w czasie rzeczywistym
                            </li>
                        </ul>
                    </div>

                    <!-- Direct Contact -->
                    <div class="mt-8 border-t border-slate-200 pt-6">
                        <p class="font-mono text-xs text-slate-400 mb-2">
                            Bezpośredni kontakt:
                        </p>
                        <div
                            class="flex flex-wrap items-center gap-4 text-xs font-medium text-slate-700"
                        >
                            <a
                                href={`tel:${phoneNumber}`}
                                class="flex items-center gap-1.5 hover:text-blue-600 transition-colors"
                            >
                                <svg
                                    class="w-4 h-4 text-slate-400"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                    ></path></svg
                                >
                                Tel: {formattedPhone}
                            </a>
                            <span class="text-slate-300">•</span>
                            <a
                                href="mailto:kontakt@logarytmika.pl"
                                class="flex items-center gap-1.5 hover:text-blue-600 transition-colors"
                            >
                                <svg
                                    class="w-4 h-4 text-slate-400"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path></svg
                                >
                                kontakt@logarytmika.pl
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Right: pricing card -->
                <div
                    class="border-t border-slate-200 bg-white p-8 lg:border-l lg:border-t-0 lg:p-12 flex flex-col justify-between"
                >
                    <div>
                        <div class="flex items-baseline gap-2">
                            <span
                                class="font-mono text-4xl font-bold text-slate-900"
                                >80 zł</span
                            >
                            <span class="font-mono text-sm text-slate-500"
                                >/ 60 min</span
                            >
                        </div>
                        <p class="mt-1 font-mono text-xs text-slate-500">
                            Korepetycje indywidualne 1:1 online
                        </p>

                        <div class="mt-6 border-t border-slate-200 pt-6">
                            <ul class="space-y-3">
                                <li
                                    class="flex items-start gap-3 text-sm text-slate-700"
                                >
                                    <svg
                                        class="mt-0.5 h-5 w-5 flex-none text-blue-600"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                                        ></path>
                                    </svg>
                                    Indywidualne podejście (E8, Matura, INF.03, INF.04)
                                </li>
                                <li
                                    class="flex items-start gap-3 text-sm text-slate-700"
                                >
                                    <svg
                                        class="mt-0.5 h-5 w-5 flex-none text-blue-600"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                                        ></path>
                                    </svg>
                                    Wsparcie i porady dotyczące przygotowań do egzaminu
                                </li>
                                <li
                                    class="flex items-start gap-3 text-sm text-slate-700"
                                >
                                    <svg
                                        class="mt-0.5 h-5 w-5 flex-none text-blue-600"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                                        ></path>
                                    </svg>
                                    Elastyczne terminy i płatność po zajęciach
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Direct SMS CTA -->
                    <div class="mt-8">
                        <a
                            href={`sms:${phoneNumber}?body=${defaultSmsBody}`}
                            class="btn-primary w-full flex items-center justify-center gap-2 py-3.5"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                                ></path></svg
                            >
                            Napisz SMS i Zarezerwuj ↗
                        </a>
                        <p
                            class="mt-2 text-center font-mono text-[11px] text-slate-400"
                        >
                            Odpiszę z propozycją wolnych terminów.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="bg-white">
    <div class="container-prose py-12 lg:py-16">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
            <!-- Brand -->
            <div class="col-span-2 md:col-span-1">
                <a href="/" class="flex items-center gap-0">
                    <span
                        class="text-base font-bold tracking-tight text-slate-900"
                        >LOGARYTMIKA</span
                    >
                    <span class="font-mono text-xs text-blue-600 ml-0.5"
                        >.pl</span
                    >
                </a>
                <p
                    class="mt-3 max-w-xs font-mono text-xs leading-relaxed text-slate-500"
                >
                    Rozwiązania zadań CKE i korepetycje 1:1 dla egzaminów
                    państwowych.
                </p>
            </div>

            {
                footerLinks.map((col) => (
                    <div>
                        <h4 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-400">
                            {col.title}
                        </h4>
                        <ul class="mt-4 space-y-2">
                            {col.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="text-sm text-slate-600 transition-colors hover:text-slate-900"
                                        {...(link.href.startsWith("http")
                                            ? {
                                                  target: "_blank",
                                                  rel: "noopener noreferrer",
                                              }
                                            : {})}
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div
            class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-8 sm:flex-row"
        >
            <p class="font-mono text-xs text-slate-400">
                &copy; {new Date().getFullYear()} Logarytmika.pl · Wszelkie prawa
                zastrzeżone
            </p>
            <p class="font-mono text-xs text-slate-400">
                Egzamin 8-klasisty · Matura · INF.03 · INF.04
            </p>
        </div>
    </div>
</footer>
