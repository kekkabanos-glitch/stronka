---
const navLinks = [
    { label: "Korepetycje", href: "#korepetycje", code: "01" },
    //{ label: "Arkusze CKE", href: "#arkusze", code: "02" },
    //{ label: "Baza Wiedzy", href: "#baza-wiedzy", code: "03" },
    { label: "Cennik", href: "#cennik", code: "02" },
];
---

<header
    id="navbar"
    class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-sm"
>
    <nav class="container-prose flex h-14 items-center justify-between gap-3">
        <!-- Logo -->
        <a
            href="/"
            class="flex shrink-0 items-center gap-0"
            aria-label="Logarytmika.pl strona główna"
        >
            <span class="text-base font-bold tracking-tight text-slate-900"
                >LOGARYTMIKA</span
            >
            <span class="font-mono text-xs font-medium text-blue-600 ml-0.5"
                >.pl</span
            >
        </a>

        <!-- Desktop Links -->
        <ul class="hidden items-center gap-1 lg:flex">
            {
                navLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="group flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900"
                        >
                            <span class="font-mono text-[10px] text-slate-400 group-hover:text-blue-600">
                                {link.code}
                            </span>
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <!-- Right Side: Search + CTA + Mobile Toggle Container -->
        <div class="flex items-center gap-2 sm:gap-3">
            <!-- Desktop Search Button -->
            <button
                id="nav-search-btn"
                class="hidden items-center gap-2 rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm text-slate-400 transition-colors hover:border-slate-300 hover:bg-white lg:flex"
                aria-label="Otwórz wyszukiwarkę"
            >
                <svg
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
                    ></path>
                </svg>
                <span class="text-xs">Szukaj...</span>
                <kbd
                    class="font-mono text-[10px] rounded border border-slate-300 bg-white px-1.5 py-0.5 text-slate-400"
                    >⌘K</kbd
                >
            </button>

            <!-- Panel Ucznia CTA (Always cleanly right-aligned) -->
            <a
                href="https://app.logarytmika.pl"
                class="btn-outline shrink-0 whitespace-nowrap px-2.5 py-1.5 text-xs sm:px-3 sm:py-2 sm:text-sm"
                target="_blank"
                rel="noopener noreferrer"
            >
                Panel Ucznia
                <svg
                    class="ml-1 h-3 w-3 sm:ml-1.5 sm:h-3.5 sm:w-3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7 17 17 7M7 7h10v10"></path>
                </svg>
            </a>

            <!-- Mobile Toggle -->
            <button
                id="mobile-toggle"
                class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 text-slate-900 sm:h-9 sm:w-9 lg:hidden"
                aria-label="Otwórz menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <svg
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div
        id="mobile-menu"
        class="hidden border-t border-slate-200 bg-white lg:hidden"
    >
        <ul class="container-prose flex flex-col py-3">
            {
                navLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="flex items-center gap-3 rounded-md px-3 py-2.5 text-base font-medium text-slate-700 hover:bg-slate-50"
                        >
                            <span class="font-mono text-xs text-slate-400">
                                {link.code}
                            </span>
                            {link.label}
                        </a>
                    </li>
                ))
            }
            <li class="mt-2 border-t border-slate-100 pt-3">
                <a
                    href="https://app.logarytmika.pl"
                    class="btn-outline w-full"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Panel Ucznia
                </a>
            </li>
        </ul>
    </div>
</header>

<script>
    const toggle = document.getElementById("mobile-toggle");
    const menu = document.getElementById("mobile-menu");
    const navSearchBtn = document.getElementById("nav-search-btn");

    toggle?.addEventListener("click", () => {
        const expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!expanded));
        menu?.classList.toggle("hidden");
    });

    menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            menu?.classList.add("hidden");
            toggle?.setAttribute("aria-expanded", "false");
        });
    });

    // Cmd+K / Ctrl+K to scroll to search
    function focusSearch() {
        const searchInput = document.getElementById("hero-search-input");
        searchInput?.scrollIntoView({ behavior: "smooth", block: "center" });
        setTimeout(() => (searchInput as HTMLInputElement)?.focus(), 400);
    }

    navSearchBtn?.addEventListener("click", focusSearch);

    document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
            e.preventDefault();
            focusSearch();
        }
    });
</script>
