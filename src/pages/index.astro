  </div>

  <div
    class="mt-6 flex items-center justify-between font-mono text-xs text-slate-500"
  >
    <span>Aktualizacja: {new Date().toLocaleDateString("pl-PL")}</span>
    <a
      href="#baza-wiedzy"
      class="text-blue-600 underline decoration-blue-600/30 underline-offset-4 transition-colors hover:decoration-blue-600"
    >
      → Zobacz wszystkie materiały
    </a>
  </div>
</BaseLayout>
-->

  <!-- <TrustSection /> -->
  <!-- <SubjectsSection /> -->
  <FooterCTA />
</BaseLayout>
